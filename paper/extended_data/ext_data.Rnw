<<cron_n_table, echo=FALSE, results="asis">>=
lines <- readLines("../../results/crop_n_table.tex")
lines <- gsub('North America', 'N. America', lines)
lines <- gsub('South America', 'S. America', lines)
lines <- gsub('region', 'Region', lines)
lines <- gsub('epoch', 'Epoch', lines)
lines <- gsub('crop', 'Crop', lines)
lines <- gsub('Groundnuts', 'G.nuts', lines)
lines <- gsub('2C', '2\\\\degr{}', lines)
lines <- gsub('3C', '3\\\\degr{}', lines)
lines <- gsub(' / ', '/', lines)
cat(lines, sep = '\n')
@
\caption{Numbers of samples (grid points with significant changes) used to
generate each box plot in Figure \ref{main-fig:crop_changes}. ``N. America''
stands for North America, ``S. America'' for South America, and ``G.nuts'' for
groundnuts.}
\label{tab:bar_ns}
\end{table}

