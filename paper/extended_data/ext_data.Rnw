\begin{figure*}[p]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/historical_by_model}
    \caption{\textbf{Mean annual hail-prone days in historical (1980-1999)
    runs.} n=20 per grid point. There is one row per model (each CMIP6 model and
    ERA5 reanalysis), and one column per proxy. Inset numbers in square brackets
    show the normalisation factor by which each map was scaled, the maximum
    annual hail-prone days over the historical period. The models MPI-ESM1-2-HR
    and EC-Earth produced similar numbers of hail-prone days to ERA5, while
    MIROC6, CMCC-CM2-SR5, CMCC-ESM2, and MRI-ESM2-0 showed moderately more and
    CNRM-CM6-1 and GISS-E2-1-G showed considerably more hail-prone days than
    ERA5.}
    \label{fig:historical_annual_means}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/hail_diffs_3C}
    \caption{\textbf{Differences in mean annual hail-prone days by model and
    proxy for 3 \degr{} global warming.} Stippling shows regions for which the
    difference between epochs was statistically significant ($p < 0.05$ using a
    two-sided Welch's t-test, n=20 years per epoch).}
    \label{fig:hail_diffs_3C}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/historical_crop_proportion_hail_prone}
    \caption{\textbf{Multimodel, multi-proxy mean hail-prone proportions of
    cropping seasons for the historical period}. n=20 per grid point. Brackets
    in titles show the spatial average of mean hail-prone proportion of cropping
    seasons by crop (numbers of samples shown in Supplementary Table
    \ref{SM-tab:crop_spatial_samples}). Plots are subset to remove areas with no
    crop data.}
    \label{fig:historic_crop_proportions}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/crop_changes_africa}
    \caption{\textbf{Regional, relative changes in hail-prone proportion of
    cropping season for Africa}. Change in multimodel, multi-proxy mean hail-prone
    proportions (n=480) of cropping seasons for 3 \degr{} warming, for Africa,
    with changes shown as percentages of the mean historical hail-prone
    proportion (n=480) of cropping season. Crops for which there were no
    significant changes recorded are not shown. Stippling shows regions in which
    at least 50\% of the model/proxy combinations agreed with the sign of the
    mean difference and also showed significant differences in the mean ($p <
    0.05$ on a two-sided Welch's t-test, n=20 years per epoch). The colour bar
    is truncated to the range of stippled values and is non-linear with zero at
    the centre.}
    \label{fig:crop_changes_africa}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/crop_changes_asia}
    \caption{\textbf{Regional, relative changes in hail-prone proportion of
    cropping season for Asia}. As for Extended Data Figure
    \ref{fig:crop_changes_africa} but for Southern, Eastern, Northern, and
    northern South-eastern Asia.}
    \label{fig:crop_changes_asia}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/crop_changes_europe}
    \caption{\textbf{Regional, relative changes in hail-prone proportion of
    cropping season for Europe}. As for Extended Data Figure
    \ref{fig:crop_changes_africa} but for Europe, Northern Africa, Western Asia,
    and Iran.}
    \label{fig:crop_changes_europe}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/crop_changes_north_america}
    \caption{\textbf{Regional, relative changes in hail-prone proportion of
    cropping season for Northern America}. As for Extended Data Figure
    \ref{fig:crop_changes_africa} but for Northern America, Central America, and
    the Caribbean.}
    \label{fig:crop_changes_north_america}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/crop_changes_oceania}
    \caption{\textbf{Regional, relative changes in hail-prone proportion of
    cropping season for Oceania}. As for Extended Data Figure
    \ref{fig:crop_changes_africa} but for Oceania and southern South-eastern
    Asia.}
    \label{fig:crop_changes_oceania}
\end{figure*}

\begin{figure*}[h]
    \centering
    \includegraphics[width=\textwidth]{../../results/extended_data/crop_changes_south_america}
    \caption{\textbf{Regional, relative changes in hail-prone proportion of
    cropping season for South America}. As for Extended Data Figure
    \ref{fig:crop_changes_africa} but for South America.}
    \label{fig:crop_changes_south_america}
\end{figure*}

